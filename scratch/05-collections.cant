;; Collections - lists, arrays, maps, sets

;;; LISTS (immutable, linked)

(let xs '(1 2 3 4 5))
(out .say "List: ~w\n" xs)
(out .say "  .count: ~w\n" xs.count)
(out .say "  .first: ~w\n" xs.first)
(out .say "  .rest: ~w\n" xs.rest)
(out .say "  (xs 2): ~w\n" (xs 2))  ;; 0-indexed
(out .say "  .none?: ~w\n" xs.none?)
(out .say "  .some?: ~w\n" xs.some?)

;; Building lists
(out .say "  link: ~w\n" (link 0 xs))  ;; cons
(out .say "  chain: ~w\n" (chain xs '(6 7 8)))  ;; append

;; Slicing
(out .say "  .from 2: ~w\n" (xs .from 2))
(out .say "  .from 1 3: ~w\n" (xs .from 1 3))

;;; ARRAYS (mutable, fixed-size)

(let arr (array<- 'a 'b 'c 'd))
(out .say "\nArray: ~w\n" arr)
(out .say "  .count: ~w\n" arr.count)
(out .say "  (arr 0): ~w\n" (arr 0))
(arr .set! 1 'B)
(out .say "  after .set! 1 'B: ~w\n" arr)

;; Array from count
(let zeros (array<-count 5 0))
(out .say "  array<-count 5 0: ~w\n" zeros)

;;; MAPS (hash tables)

;; Mutable map
(let m (!map<-))
(m .set! 'name "Alice")
(m .set! 'age 30)
(out .say "\nMutable map: ~w\n" m)
(out .say "  (m 'name): ~w\n" (m 'name))
(out .say "  .get 'age: ~w\n" (m .get 'age))
(out .say "  .get 'missing: ~w\n" (m .get 'missing))  ;; returns #no
(out .say "  .get 'missing 'default: ~w\n" (m .get 'missing 'default))
(out .say "  .keys: ~w\n" m.keys)
(out .say "  .values: ~w\n" m.values)
(out .say "  .items: ~w\n" m.items)
(out .say "  .maps? 'name: ~w\n" (m .maps? 'name))
(out .say "  .maps? 'missing: ~w\n" (m .maps? 'missing))

;; Immutable map
(let im (map<- {~ 'x 10} {~ 'y 20}))
(out .say "\nImmutable map: ~w\n" im)
(out .say "  (im 'x): ~w\n" (im 'x))

;;; SETS

(let s (set<- 1 2 3))
(out .say "\nSet: ~w\n" s)
(s .add! 4)
(s .add! 2)  ;; already present
(out .say "  after adding 4 and 2: ~w\n" s)
(out .say "  .maps? 3: ~w\n" (s .maps? 3))
(out .say "  .maps? 99: ~w\n" (s .maps? 99))

;;; ITERATION with `for`

(out .say "\nIteration:\n")

;; for each - like map
(out .say "  for each (square): ~w\n"
  (for each [(x '(1 2 3 4))]
    (* x x)))

;; for keep - like filter
(out .say "  for keep (even?): ~w\n"
  (for keep [(x '(1 2 3 4 5 6))]
    x.even?))

;; for each! - side effects
(out .say "  for each! (print):\n")
(for each! [(x '(a b c))]
  (out .say "    item: ~w\n" x))

;; for fold - reduce from right
(out .say "  for fold (sum): ~w\n"
  (for fold [(x '(1 2 3 4 5)) (acc 0)]
    (+ x acc)))

;; for amass - reduce from left (often more natural)
(out .say "  for amass (build list): ~w\n"
  (for amass [(acc '()) (x '(1 2 3))]
    (link (* x 10) acc)))

;;; RANGES

(out .say "\nRanges:\n")
(out .say "  0.till 5: ~w\n" (0 .till 5))       ;; 0,1,2,3,4
(out .say "  1.thru 5: ~w\n" (1 .thru 5))       ;; 1,2,3,4,5
(out .say "  0.till 10 2: ~w\n" (0 .till 10 2)) ;; 0,2,4,6,8 (stride 2)
(out .say "  5.down-thru 1: ~w\n" (5 .down-thru 1))  ;; 5,4,3,2,1

;; Ranges are lazy - good for large ranges
(out .say "  sum of 1 to 100: ~w\n"
  (for fold [(n (1 .thru 100)) (total 0)]
    (+ n total)))
